{
  "name": "@ty-everett/vectorcraft",
  "private": true,
  "version": "0.3.0",
  "description": "A browser-native local-AI crafting game deployed through CARS.",
  "license": "MIT",
  "scripts": {
    "start": "lars start",
    "dev": "npm --prefix frontend run dev",
    "verify": "npm --prefix frontend run verify",
    "corpus:export": "node scripts/export-corpus.mjs",
    "corpus:stage": "node scripts/stage-contributions.mjs",
    "build:app": "npm --prefix frontend run build",
    "build": "cars build Babbage",
    "predeploy": "cars project ensure-balance Babbage --min 1 --topup-to 250000",
    "deploy": "cars release now Babbage"
  },
  "devDependencies": {
    "@p2ppsr/cars-cli": "1.2.32",
    "@p2ppsr/lars": "1.5.12"
  },
  "overrides": {
    "@bsv/sdk": "2.4.0",
    "@bsv/wallet-toolbox-client": "2.9.0"
  }
}
